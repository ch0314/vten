[connectivity]
# AXI4 memory interface mapping
{% for name, iface in interfaces.items() if iface.protocol == "axi4" %}
sp={{ kernel_name }}_1.{{ iface.ext_port }}:{{ iface.memory_bank | default("DDR[0]") }}
{% endfor %}

# Stream connections (multi-kernel)
{% for conn in stream_connections %}
stream_connect={{ conn.source }}:{{ conn.dest }}
{% endfor %}
