# project_setup.tcl — vten build Stage 1
# Jinja2 렌더링 후 vivado -mode batch로 실행
# args: <project_dir> <part> <vten_sv_dir>

set proj_dir  [lindex $argv 0]
set part      [lindex $argv 1]
set vten_sv   [lindex $argv 2]
set project_root [lindex $argv 3]

# 1) 프로젝트 생성
if {$part ne ""} {
    create_project vten_sim $proj_dir -part $part -force
} else {
    create_project vten_sim $proj_dir -force
}
set_property target_simulator XSim [current_project]

# 2) vten_sv 라이브러리 등록
add_files -fileset sim_1 [glob $vten_sv/*.svh $vten_sv/*.sv]

# 3) 사용자 RTL 등록 (Python에서 glob 확장된 절대 경로)
{% for src in rtl_files %}
add_files -fileset sim_1 {{ src }}
{% endfor %}

# 4) include 경로 설정
{% if include_dirs %}
set_property include_dirs { {% for d in include_dirs %}$project_root/{{ d }} {% endfor %}} [get_filesets sim_1]
{% endif %}

# 5-a) IP 생성 (선언형)
{% for ip in ip_create %}
file mkdir $project_root/{{ ip.output_dir }}
create_ip -name {{ ip.component }} -vendor {{ ip.vendor }} -library {{ ip.library }} \
          -version {{ ip.version }} -module_name {{ ip.name }} \
          -dir $project_root/{{ ip.output_dir }}
{% for prop, val in ip.properties.items() %}
set_property -dict [list CONFIG.{{ prop }} {{ val }}] [get_ips {{ ip.name }}]
{% endfor %}
{% endfor %}

# 5-b) IP 등록 (기존 .xci 참조)
{% for xci in ip_sources %}
add_files {{ xci }}
{% endfor %}

# 5-c) IP 합성 체크포인트 + 시뮬레이션 소스 생성
{% if ip_sources or ip_create %}
foreach ip_inst [get_ips *] {
    set ip_file [get_files -of_objects $ip_inst -filter {FILE_TYPE == IP}]
    if {$ip_file ne ""} {
        set_property generate_synth_checkpoint true $ip_file
    }
}
generate_target all [get_ips *]
{% endif %}

# 5-d) Verilator용 sim_netlist 생성
#      합성된 IP를 UNISIM primitive 기반 넷리스트로 export
file mkdir $project_root/build/ip_sim_netlist
foreach ip_inst [get_ips *] {
    set ip_name [get_property NAME $ip_inst]
    set netlist_path "$project_root/build/ip_sim_netlist/${ip_name}_sim_netlist.v"
    if {[catch {
        open_checkpoint [get_property DCP_FILE $ip_inst]
        write_verilog -mode funcsim $netlist_path -force
        close_design
    } err]} {
        puts "WARNING: sim_netlist generation failed for $ip_name: $err"
    }
}

# 6) 종료
close_project
