# package_ip.tcl — Auto-generated Vivado IP Packager TCL
# Generated by vten codegen from kernel_spec.yaml
# Usage: vivado -mode batch -source package_ip.tcl

set project_dir [file dirname [file normalize [info script]]]
{% if project_root %}
set project_root [file normalize "$project_dir/{{ project_root }}"]
{% else %}
set project_root $project_dir
{% endif %}
{% if vten_root %}
set vten_root [file normalize "$project_dir/{{ vten_root }}"]
{% endif %}

# Create packaging project
create_project package_ip $project_dir/package_ip_proj -force{{ " -part " ~ part if part else "" }}

# Add RTL sources
{% for src in rtl_sources %}
add_files $project_root/{{ src }}
{% endfor %}

# Add codegen-generated files (wrapper + axilite controller)
{% for gen_file in generated_files %}
add_files $project_dir/{{ gen_file }}
{% endfor %}

# Add vten SV interface definitions
{% for sv_file in vten_sv_files %}
add_files $vten_root/{{ sv_file }}
{% endfor %}

# ── IP 생성 (선언형) ──
{% for ip in ip_create %}
file mkdir $project_root/{{ ip.output_dir }}
create_ip -name {{ ip.component }} -vendor {{ ip.vendor }} -library {{ ip.library }} \
          -version {{ ip.version }} -module_name {{ ip.name }} \
          -dir $project_root/{{ ip.output_dir }}
{% for prop, val in ip.properties.items() %}
set_property -dict [list CONFIG.{{ prop }} {{ val }}] [get_ips {{ ip.name }}]
{% endfor %}
{% endfor %}

# ── IP 등록 (기존 .xci 참조) ──
{% for xci in ip_sources %}
add_files {{ xci }}
{% endfor %}

{% if ip_sources or ip_create %}
generate_target all [get_ips *]
{% endif %}

set_property top {{ kernel_name }} [current_fileset]
update_compile_order -fileset sources_1

# Package IP
ipx::package_project -root_dir $project_dir/ip_repo -vendor user.org -library kernel -taxonomy /KernelIP -import_files -force

# ── Clock & Reset association ──
{% for name, iface in interfaces.items() %}
ipx::associate_bus_interfaces -busif {{ iface.ext_port }} -clock ap_clk [ipx::current_core]
{% endfor %}

# ── Set address space for AXI masters ──
{% for name, iface in interfaces.items() if iface.protocol == "axi4" %}
set {{ iface.ext_port }}_as [ipx::get_address_spaces -quiet {{ iface.ext_port }} -of_objects [ipx::current_core]]
if {${{ iface.ext_port }}_as ne ""} {
    set_property range_format     long     [ipx::get_address_spaces {{ iface.ext_port }} -of_objects [ipx::current_core]]
    set_property range_minimum    4096     [ipx::get_address_spaces {{ iface.ext_port }} -of_objects [ipx::current_core]]
    set_property width            {{ iface.addr_width }}       [ipx::get_address_spaces {{ iface.ext_port }} -of_objects [ipx::current_core]]
    set_property range            {{ 2 ** iface.addr_width }}  [ipx::get_address_spaces {{ iface.ext_port }} -of_objects [ipx::current_core]]
}
{% endfor %}

# ── Register map for AXI-Lite slave ──
{% for name, iface in interfaces.items() if iface.protocol == "axi4_lite" %}
set ctrl_map [ipx::get_memory_maps -quiet {{ iface.ext_port }} -of_objects [ipx::current_core]]
if {$ctrl_map ne ""} {
    set addr_blk [ipx::get_address_blocks -quiet reg0 -of_objects $ctrl_map]
    if {$addr_blk ne ""} {
{% for reg in registers %}
        ipx::add_register {{ reg.name }} $addr_blk
        set_property address_offset {{ "0x%03X" | format(reg.offset) }} [ipx::get_registers {{ reg.name }} -of_objects $addr_blk]
{% endfor %}
    }
}
{% endfor %}

# ── Kernel type markers ──
set_property xpm_libraries {XPM_MEMORY XPM_FIFO} [ipx::current_core]
set_property sdx_kernel true [ipx::current_core]
set_property sdx_kernel_type rtl [ipx::current_core]

set_property core_revision 2 [ipx::current_core]
ipx::create_xgui_files [ipx::current_core]
ipx::update_checksums [ipx::current_core]
ipx::save_core [ipx::current_core]

puts "IP packaging complete: $project_dir/ip_repo"
