`timescale {{ timescale }}

`include "vten_types.svh"

module tb_top;

    // ── Clock and Reset ──
    logic {{ clock_name }};
    logic {{ reset_name }};

    initial {{ clock_name }} = 0;
    always #({{ clock_period_ns / 2.0 }}) {{ clock_name }} = ~{{ clock_name }};

    initial begin
{% if reset_active_low %}
        {{ reset_name }} = 0;
        #100;
        {{ reset_name }} = 1;
{% else %}
        {{ reset_name }} = 1;
        #100;
        {{ reset_name }} = 0;
{% endif %}
    end

    // ── Global Cycle Counter ──
    int cycle_count;
    always_ff @(posedge {{ clock_name }} or negedge {{ reset_name }}) begin
        if (!{{ reset_name }})
            cycle_count <= 0;
        else
            cycle_count <= cycle_count + 1;
    end

    // ── Wire Declarations ──
{% for bfm in bfms %}
{% if bfm.protocol == "axi4_stream" %}
    logic [{{ bfm.data_width - 1 }}:0] {{ bfm.rtl_port_prefix }}_tdata;
    logic                              {{ bfm.rtl_port_prefix }}_tvalid;
    logic                              {{ bfm.rtl_port_prefix }}_tready;
    logic                              {{ bfm.rtl_port_prefix }}_tlast;
{% elif bfm.protocol == "axi4" %}
    // AR channel
    logic [{{ bfm.parameters.ADDR_W - 1 }}:0] {{ bfm.rtl_port_prefix }}_araddr;
    logic [7:0]                        {{ bfm.rtl_port_prefix }}_arlen;
    logic [2:0]                        {{ bfm.rtl_port_prefix }}_arsize;
    logic [1:0]                        {{ bfm.rtl_port_prefix }}_arburst;
    logic                              {{ bfm.rtl_port_prefix }}_arvalid;
    logic                              {{ bfm.rtl_port_prefix }}_arready;
    // R channel
    logic [{{ bfm.data_width - 1 }}:0] {{ bfm.rtl_port_prefix }}_rdata;
    logic [1:0]                        {{ bfm.rtl_port_prefix }}_rresp;
    logic                              {{ bfm.rtl_port_prefix }}_rlast;
    logic                              {{ bfm.rtl_port_prefix }}_rvalid;
    logic                              {{ bfm.rtl_port_prefix }}_rready;
    // AW channel
    logic [{{ bfm.parameters.ADDR_W - 1 }}:0] {{ bfm.rtl_port_prefix }}_awaddr;
    logic [7:0]                        {{ bfm.rtl_port_prefix }}_awlen;
    logic [2:0]                        {{ bfm.rtl_port_prefix }}_awsize;
    logic [1:0]                        {{ bfm.rtl_port_prefix }}_awburst;
    logic                              {{ bfm.rtl_port_prefix }}_awvalid;
    logic                              {{ bfm.rtl_port_prefix }}_awready;
    // W channel
    logic [{{ bfm.data_width - 1 }}:0] {{ bfm.rtl_port_prefix }}_wdata;
    logic [{{ bfm.data_width // 8 - 1 }}:0] {{ bfm.rtl_port_prefix }}_wstrb;
    logic                              {{ bfm.rtl_port_prefix }}_wlast;
    logic                              {{ bfm.rtl_port_prefix }}_wvalid;
    logic                              {{ bfm.rtl_port_prefix }}_wready;
    // B channel
    logic [1:0]                        {{ bfm.rtl_port_prefix }}_bresp;
    logic                              {{ bfm.rtl_port_prefix }}_bvalid;
    logic                              {{ bfm.rtl_port_prefix }}_bready;
{% elif bfm.protocol == "axi4_lite" %}
    // AW channel
    logic [{{ bfm.parameters.ADDR_W - 1 }}:0] {{ bfm.rtl_port_prefix }}_awaddr;
    logic                              {{ bfm.rtl_port_prefix }}_awvalid;
    logic                              {{ bfm.rtl_port_prefix }}_awready;
    // W channel
    logic [{{ bfm.data_width - 1 }}:0] {{ bfm.rtl_port_prefix }}_wdata;
    logic [{{ bfm.data_width // 8 - 1 }}:0] {{ bfm.rtl_port_prefix }}_wstrb;
    logic                              {{ bfm.rtl_port_prefix }}_wvalid;
    logic                              {{ bfm.rtl_port_prefix }}_wready;
    // B channel
    logic [1:0]                        {{ bfm.rtl_port_prefix }}_bresp;
    logic                              {{ bfm.rtl_port_prefix }}_bvalid;
    logic                              {{ bfm.rtl_port_prefix }}_bready;
    // AR channel
    logic [{{ bfm.parameters.ADDR_W - 1 }}:0] {{ bfm.rtl_port_prefix }}_araddr;
    logic                              {{ bfm.rtl_port_prefix }}_arvalid;
    logic                              {{ bfm.rtl_port_prefix }}_arready;
    // R channel
    logic [{{ bfm.data_width - 1 }}:0] {{ bfm.rtl_port_prefix }}_rdata;
    logic [1:0]                        {{ bfm.rtl_port_prefix }}_rresp;
    logic                              {{ bfm.rtl_port_prefix }}_rvalid;
    logic                              {{ bfm.rtl_port_prefix }}_rready;
{% endif %}
{% endfor %}

    // ── DUT Instantiation ──
    {{ top_module }} dut (
        .{{ clock_name }}({{ clock_name }}),
        .{{ reset_name }}({{ reset_name }}){% if bfms %},{% endif %}

{% for bfm in bfms %}
{% if bfm.protocol == "axi4_stream" %}
        .{{ bfm.rtl_port_prefix }}_tdata({{ bfm.rtl_port_prefix }}_tdata),
        .{{ bfm.rtl_port_prefix }}_tvalid({{ bfm.rtl_port_prefix }}_tvalid),
        .{{ bfm.rtl_port_prefix }}_tready({{ bfm.rtl_port_prefix }}_tready),
        .{{ bfm.rtl_port_prefix }}_tlast({{ bfm.rtl_port_prefix }}_tlast){{ "," if not loop.last else "" }}
{% elif bfm.protocol == "axi4" %}
        .{{ bfm.rtl_port_prefix }}_araddr({{ bfm.rtl_port_prefix }}_araddr),
        .{{ bfm.rtl_port_prefix }}_arlen({{ bfm.rtl_port_prefix }}_arlen),
        .{{ bfm.rtl_port_prefix }}_arsize({{ bfm.rtl_port_prefix }}_arsize),
        .{{ bfm.rtl_port_prefix }}_arburst({{ bfm.rtl_port_prefix }}_arburst),
        .{{ bfm.rtl_port_prefix }}_arvalid({{ bfm.rtl_port_prefix }}_arvalid),
        .{{ bfm.rtl_port_prefix }}_arready({{ bfm.rtl_port_prefix }}_arready),
        .{{ bfm.rtl_port_prefix }}_rdata({{ bfm.rtl_port_prefix }}_rdata),
        .{{ bfm.rtl_port_prefix }}_rresp({{ bfm.rtl_port_prefix }}_rresp),
        .{{ bfm.rtl_port_prefix }}_rlast({{ bfm.rtl_port_prefix }}_rlast),
        .{{ bfm.rtl_port_prefix }}_rvalid({{ bfm.rtl_port_prefix }}_rvalid),
        .{{ bfm.rtl_port_prefix }}_rready({{ bfm.rtl_port_prefix }}_rready),
        .{{ bfm.rtl_port_prefix }}_awaddr({{ bfm.rtl_port_prefix }}_awaddr),
        .{{ bfm.rtl_port_prefix }}_awlen({{ bfm.rtl_port_prefix }}_awlen),
        .{{ bfm.rtl_port_prefix }}_awsize({{ bfm.rtl_port_prefix }}_awsize),
        .{{ bfm.rtl_port_prefix }}_awburst({{ bfm.rtl_port_prefix }}_awburst),
        .{{ bfm.rtl_port_prefix }}_awvalid({{ bfm.rtl_port_prefix }}_awvalid),
        .{{ bfm.rtl_port_prefix }}_awready({{ bfm.rtl_port_prefix }}_awready),
        .{{ bfm.rtl_port_prefix }}_wdata({{ bfm.rtl_port_prefix }}_wdata),
        .{{ bfm.rtl_port_prefix }}_wstrb({{ bfm.rtl_port_prefix }}_wstrb),
        .{{ bfm.rtl_port_prefix }}_wlast({{ bfm.rtl_port_prefix }}_wlast),
        .{{ bfm.rtl_port_prefix }}_wvalid({{ bfm.rtl_port_prefix }}_wvalid),
        .{{ bfm.rtl_port_prefix }}_wready({{ bfm.rtl_port_prefix }}_wready),
        .{{ bfm.rtl_port_prefix }}_bresp({{ bfm.rtl_port_prefix }}_bresp),
        .{{ bfm.rtl_port_prefix }}_bvalid({{ bfm.rtl_port_prefix }}_bvalid),
        .{{ bfm.rtl_port_prefix }}_bready({{ bfm.rtl_port_prefix }}_bready){{ "," if not loop.last else "" }}
{% elif bfm.protocol == "axi4_lite" %}
        .{{ bfm.rtl_port_prefix }}_awaddr({{ bfm.rtl_port_prefix }}_awaddr),
        .{{ bfm.rtl_port_prefix }}_awvalid({{ bfm.rtl_port_prefix }}_awvalid),
        .{{ bfm.rtl_port_prefix }}_awready({{ bfm.rtl_port_prefix }}_awready),
        .{{ bfm.rtl_port_prefix }}_wdata({{ bfm.rtl_port_prefix }}_wdata),
        .{{ bfm.rtl_port_prefix }}_wstrb({{ bfm.rtl_port_prefix }}_wstrb),
        .{{ bfm.rtl_port_prefix }}_wvalid({{ bfm.rtl_port_prefix }}_wvalid),
        .{{ bfm.rtl_port_prefix }}_wready({{ bfm.rtl_port_prefix }}_wready),
        .{{ bfm.rtl_port_prefix }}_bresp({{ bfm.rtl_port_prefix }}_bresp),
        .{{ bfm.rtl_port_prefix }}_bvalid({{ bfm.rtl_port_prefix }}_bvalid),
        .{{ bfm.rtl_port_prefix }}_bready({{ bfm.rtl_port_prefix }}_bready),
        .{{ bfm.rtl_port_prefix }}_araddr({{ bfm.rtl_port_prefix }}_araddr),
        .{{ bfm.rtl_port_prefix }}_arvalid({{ bfm.rtl_port_prefix }}_arvalid),
        .{{ bfm.rtl_port_prefix }}_arready({{ bfm.rtl_port_prefix }}_arready),
        .{{ bfm.rtl_port_prefix }}_rdata({{ bfm.rtl_port_prefix }}_rdata),
        .{{ bfm.rtl_port_prefix }}_rresp({{ bfm.rtl_port_prefix }}_rresp),
        .{{ bfm.rtl_port_prefix }}_rvalid({{ bfm.rtl_port_prefix }}_rvalid),
        .{{ bfm.rtl_port_prefix }}_rready({{ bfm.rtl_port_prefix }}_rready){{ "," if not loop.last else "" }}
{% endif %}
{% endfor %}
    );

    // ── SHM Controller ──
    logic        feed_valid;
    bfm_cmd_t    feed_data;
    logic        feed_ready;
    logic        feed_done;
    logic        sched_all_committed;
    logic        sched_all_drained;
    logic        sched_error;
    logic [15:0] sched_error_cmd_id;
    logic [15:0] sched_error_code;

    vten_shm_controller #(
        .MAX_CMDS({{ max_cmds }})
    ) shm_ctrl (
        .clk({{ clock_name }}),
        .rst_n({{ reset_name }}),
        .feed_valid(feed_valid),
        .feed_data(feed_data),
        .feed_ready(feed_ready),
        .feed_done(feed_done),
        .sched_all_committed(sched_all_committed),
        .sched_all_drained(sched_all_drained),
        .sched_error(sched_error),
        .sched_error_cmd_id(sched_error_cmd_id),
        .sched_error_code(sched_error_code)
    );

    // ── Command Scheduler ──
    vten_bfm_cmd_if bfm_cmd[{{ max_bfms }}]();

    // ── iface_to_bfm Mapping ──
    int iface_to_bfm [0:{{ max_ifaces }}-1];
    initial begin
        for (int i = 0; i < {{ max_ifaces }}; i++)
            iface_to_bfm[i] = -1;
{% for iface_id, bfm_idx in iface_to_bfm.items() %}
        iface_to_bfm[{{ iface_id }}] = {{ bfm_idx }};
{% endfor %}
    end

    vten_command_scheduler #(
        .MAX_CMDS({{ max_cmds }}),
        .MAX_BFMS({{ max_bfms }}),
        .MAX_IFACES({{ max_ifaces }})
    ) scheduler (
        .clk({{ clock_name }}),
        .rst_n({{ reset_name }}),
        .feed_valid(feed_valid),
        .feed_data(feed_data),
        .feed_ready(feed_ready),
        .feed_done(feed_done),
        .all_committed(sched_all_committed),
        .all_drained(sched_all_drained),
        .error_flag(sched_error),
        .error_cmd_id(sched_error_cmd_id),
        .error_code(sched_error_code),
        .bfm(bfm_cmd),
        .cycle_count(cycle_count),
        .iface_to_bfm(iface_to_bfm)
    );

    // ── BFM Instantiations ──
{% for bfm in bfms %}
    {{ bfm.module_name }} #(
{% for pname, pval in bfm.parameters.items() %}
        .{{ pname }}({{ pval }}){{ "," if not loop.last else "" }}
{% endfor %}
    ) {{ bfm.name }} (
        .clk({{ clock_name }}),
        .rst_n({{ reset_name }}),
{% if bfm.protocol == "axi4_stream" %}
{% if bfm.role == "master" %}
        .m_tdata({{ bfm.rtl_port_prefix }}_tdata),
        .m_tvalid({{ bfm.rtl_port_prefix }}_tvalid),
        .m_tready({{ bfm.rtl_port_prefix }}_tready),
        .m_tlast({{ bfm.rtl_port_prefix }}_tlast),
        .s_tdata('0),
        .s_tvalid(1'b0),
        .s_tready(),
        .s_tlast(1'b0),
{% else %}
        .m_tdata(),
        .m_tvalid(),
        .m_tready(1'b1),
        .m_tlast(),
        .s_tdata({{ bfm.rtl_port_prefix }}_tdata),
        .s_tvalid({{ bfm.rtl_port_prefix }}_tvalid),
        .s_tready({{ bfm.rtl_port_prefix }}_tready),
        .s_tlast({{ bfm.rtl_port_prefix }}_tlast),
{% endif %}
{% elif bfm.protocol == "axi4" %}
        .s_araddr({{ bfm.rtl_port_prefix }}_araddr),
        .s_arlen({{ bfm.rtl_port_prefix }}_arlen),
        .s_arsize({{ bfm.rtl_port_prefix }}_arsize),
        .s_arburst({{ bfm.rtl_port_prefix }}_arburst),
        .s_arvalid({{ bfm.rtl_port_prefix }}_arvalid),
        .s_arready({{ bfm.rtl_port_prefix }}_arready),
        .s_rdata({{ bfm.rtl_port_prefix }}_rdata),
        .s_rresp({{ bfm.rtl_port_prefix }}_rresp),
        .s_rlast({{ bfm.rtl_port_prefix }}_rlast),
        .s_rvalid({{ bfm.rtl_port_prefix }}_rvalid),
        .s_rready({{ bfm.rtl_port_prefix }}_rready),
        .s_awaddr({{ bfm.rtl_port_prefix }}_awaddr),
        .s_awlen({{ bfm.rtl_port_prefix }}_awlen),
        .s_awsize({{ bfm.rtl_port_prefix }}_awsize),
        .s_awburst({{ bfm.rtl_port_prefix }}_awburst),
        .s_awvalid({{ bfm.rtl_port_prefix }}_awvalid),
        .s_awready({{ bfm.rtl_port_prefix }}_awready),
        .s_wdata({{ bfm.rtl_port_prefix }}_wdata),
        .s_wstrb({{ bfm.rtl_port_prefix }}_wstrb),
        .s_wlast({{ bfm.rtl_port_prefix }}_wlast),
        .s_wvalid({{ bfm.rtl_port_prefix }}_wvalid),
        .s_wready({{ bfm.rtl_port_prefix }}_wready),
        .s_bresp({{ bfm.rtl_port_prefix }}_bresp),
        .s_bvalid({{ bfm.rtl_port_prefix }}_bvalid),
        .s_bready({{ bfm.rtl_port_prefix }}_bready),
{% elif bfm.protocol == "axi4_lite" %}
        .m_awaddr({{ bfm.rtl_port_prefix }}_awaddr),
        .m_awvalid({{ bfm.rtl_port_prefix }}_awvalid),
        .m_awready({{ bfm.rtl_port_prefix }}_awready),
        .m_wdata({{ bfm.rtl_port_prefix }}_wdata),
        .m_wstrb({{ bfm.rtl_port_prefix }}_wstrb),
        .m_wvalid({{ bfm.rtl_port_prefix }}_wvalid),
        .m_wready({{ bfm.rtl_port_prefix }}_wready),
        .m_bresp({{ bfm.rtl_port_prefix }}_bresp),
        .m_bvalid({{ bfm.rtl_port_prefix }}_bvalid),
        .m_bready({{ bfm.rtl_port_prefix }}_bready),
        .m_araddr({{ bfm.rtl_port_prefix }}_araddr),
        .m_arvalid({{ bfm.rtl_port_prefix }}_arvalid),
        .m_arready({{ bfm.rtl_port_prefix }}_arready),
        .m_rdata({{ bfm.rtl_port_prefix }}_rdata),
        .m_rresp({{ bfm.rtl_port_prefix }}_rresp),
        .m_rvalid({{ bfm.rtl_port_prefix }}_rvalid),
        .m_rready({{ bfm.rtl_port_prefix }}_rready),
{% endif %}
        .cmd_if(bfm_cmd[{{ bfm.interface_id }}]),
        .cycle_count(cycle_count)
    );
{% endfor %}

    // ── Unused BFM slots: tie idle=1 so all_drained works correctly ──
{% set used_bfm_indices = [] %}
{% for bfm in bfms %}
{% if used_bfm_indices.append(bfm.interface_id) %}{% endif %}
{% endfor %}
{% for i in range(max_bfms) %}
{% if i not in used_bfm_indices %}
    assign bfm_cmd[{{ i }}].idle = 1'b1;
    assign bfm_cmd[{{ i }}].done_valid = 1'b0;
    assign bfm_cmd[{{ i }}].done_cmd_id = 16'd0;
    assign bfm_cmd[{{ i }}].done_error = 1'b0;
    assign bfm_cmd[{{ i }}].done_error_code = 16'd0;
{% endif %}
{% endfor %}

    // ── Timeout ──
    initial begin
        #({{ timeout_cycles }} * {{ clock_period_ns }});
        $display("TIMEOUT: simulation exceeded {{ timeout_cycles }} cycles");
        $finish;
    end

endmodule
