// ── BFM Instantiations ──
{% for bfm in bfms %}
    {{ bfm.module_name }} #(
{% for pname, pval in bfm.parameters.items() %}
        .{{ pname }}({{ pval }}){{ "," if not loop.last else "" }}
{% endfor %}
    ) {{ bfm.name }} (
        .clk({{ clock_name }}),
        .rst_n({{ reset_name }}),
{% if bfm.protocol == "axi4_stream" %}
{% if bfm.role == "master" %}
        .m_tdata({{ bfm.rtl_port_prefix }}_tdata),
        .m_tvalid({{ bfm.rtl_port_prefix }}_tvalid),
        .m_tready({{ bfm.rtl_port_prefix }}_tready),
        .m_tlast({{ bfm.rtl_port_prefix }}_tlast),
        .s_tdata('0),
        .s_tvalid(1'b0),
        .s_tready(),
        .s_tlast(1'b0),
{% else %}
        .m_tdata(),
        .m_tvalid(),
        .m_tready(1'b1),
        .m_tlast(),
        .s_tdata({{ bfm.rtl_port_prefix }}_tdata),
        .s_tvalid({{ bfm.rtl_port_prefix }}_tvalid),
        .s_tready({{ bfm.rtl_port_prefix }}_tready),
        .s_tlast({{ bfm.rtl_port_prefix }}_tlast),
{% endif %}
{% elif bfm.protocol == "axi4" %}
        .s_araddr({{ bfm.rtl_port_prefix }}_araddr),
        .s_arlen({{ bfm.rtl_port_prefix }}_arlen),
        .s_arsize({{ bfm.rtl_port_prefix }}_arsize),
        .s_arburst({{ bfm.rtl_port_prefix }}_arburst),
        .s_arvalid({{ bfm.rtl_port_prefix }}_arvalid),
        .s_arready({{ bfm.rtl_port_prefix }}_arready),
        .s_rdata({{ bfm.rtl_port_prefix }}_rdata),
        .s_rresp({{ bfm.rtl_port_prefix }}_rresp),
        .s_rlast({{ bfm.rtl_port_prefix }}_rlast),
        .s_rvalid({{ bfm.rtl_port_prefix }}_rvalid),
        .s_rready({{ bfm.rtl_port_prefix }}_rready),
        .s_awaddr({{ bfm.rtl_port_prefix }}_awaddr),
        .s_awlen({{ bfm.rtl_port_prefix }}_awlen),
        .s_awsize({{ bfm.rtl_port_prefix }}_awsize),
        .s_awburst({{ bfm.rtl_port_prefix }}_awburst),
        .s_awvalid({{ bfm.rtl_port_prefix }}_awvalid),
        .s_awready({{ bfm.rtl_port_prefix }}_awready),
        .s_wdata({{ bfm.rtl_port_prefix }}_wdata),
        .s_wstrb({{ bfm.rtl_port_prefix }}_wstrb),
        .s_wlast({{ bfm.rtl_port_prefix }}_wlast),
        .s_wvalid({{ bfm.rtl_port_prefix }}_wvalid),
        .s_wready({{ bfm.rtl_port_prefix }}_wready),
        .s_bresp({{ bfm.rtl_port_prefix }}_bresp),
        .s_bvalid({{ bfm.rtl_port_prefix }}_bvalid),
        .s_bready({{ bfm.rtl_port_prefix }}_bready),
{% elif bfm.protocol == "axi4_lite" %}
        .m_awaddr({{ bfm.rtl_port_prefix }}_awaddr),
        .m_awvalid({{ bfm.rtl_port_prefix }}_awvalid),
        .m_awready({{ bfm.rtl_port_prefix }}_awready),
        .m_wdata({{ bfm.rtl_port_prefix }}_wdata),
        .m_wstrb({{ bfm.rtl_port_prefix }}_wstrb),
        .m_wvalid({{ bfm.rtl_port_prefix }}_wvalid),
        .m_wready({{ bfm.rtl_port_prefix }}_wready),
        .m_bresp({{ bfm.rtl_port_prefix }}_bresp),
        .m_bvalid({{ bfm.rtl_port_prefix }}_bvalid),
        .m_bready({{ bfm.rtl_port_prefix }}_bready),
        .m_araddr({{ bfm.rtl_port_prefix }}_araddr),
        .m_arvalid({{ bfm.rtl_port_prefix }}_arvalid),
        .m_arready({{ bfm.rtl_port_prefix }}_arready),
        .m_rdata({{ bfm.rtl_port_prefix }}_rdata),
        .m_rresp({{ bfm.rtl_port_prefix }}_rresp),
        .m_rvalid({{ bfm.rtl_port_prefix }}_rvalid),
        .m_rready({{ bfm.rtl_port_prefix }}_rready),
{% endif %}
        .cmd_if(bfm_cmd[{{ bfm.interface_id }}]),
        .cycle_count(cycle_count)
    );
{% endfor %}
