#!/bin/bash
# build_{{ target }}.sh — Build {{ kernel_name }} xclbin for {{ target }}
# Generated by vten codegen from kernel_spec.yaml
# Prerequisites: source Vitis settings64.sh and XRT setup.sh

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

PLATFORM="{{ platform }}"

echo "=== Step 1: Package IP ==="
vivado -mode batch -source package_ip.tcl -notrace 2>&1 | tail -20
echo ""

echo "=== Step 2: Generate XO ==="
vivado -mode batch -source gen_xo.tcl -notrace 2>&1 | tail -10
echo ""

if [ ! -f {{ kernel_name }}.xo ]; then
    echo "ERROR: XO not generated"
    exit 1
fi
echo "XO size: $(du -h {{ kernel_name }}.xo | cut -f1)"

echo "=== Step 3: Link xclbin ({{ target }}) ==="
v++ -l -t {{ target }} \
    --platform "$PLATFORM" \
    --config connectivity.cfg \
    --save-temps \
    -o {{ kernel_name }}_{{ target }}.xclbin \
    {{ kernel_name }}.xo \
    2>&1 | tail -30
echo ""

if [ ! -f {{ kernel_name }}_{{ target }}.xclbin ]; then
    echo "ERROR: xclbin not generated"
    exit 1
fi
echo "xclbin size: $(du -h {{ kernel_name }}_{{ target }}.xclbin | cut -f1)"

{% if target == "hw_emu" %}
echo "=== Step 4: Generate emconfig ==="
emconfigutil --platform "$PLATFORM" --nd 1
echo ""
{% endif %}

echo "=== Build complete ==="
echo "  XO:      $SCRIPT_DIR/{{ kernel_name }}.xo"
echo "  xclbin:  $SCRIPT_DIR/{{ kernel_name }}_{{ target }}.xclbin"
{% if target == "hw_emu" %}
echo "  emconfig: $SCRIPT_DIR/emconfig.json"
{% endif %}
echo ""
echo "To run {{ target }}:"
{% if target == "hw_emu" %}
echo "  export XCL_EMULATION_MODE=hw_emu"
{% endif %}
echo "  vten run --backend xrt --kernel {{ kernel_name }}"
